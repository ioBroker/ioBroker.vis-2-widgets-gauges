{
  "name": "iobroker.vis-2-widgets-gauges",
  "version": "2.0.3",
  "description": "Gauge widgets for ioBroker.vis-2",
  "author": "bluefox <dogafox@gmail.com>",
  "contributors": [
    "bluefox <dogafox@gmail.com>"
  ],
  "homepage": "https://github.com/ioBroker/ioBroker.vis-2-widgets-gauges",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.vis-2-widgets-gauges"
  },
  "keywords": [
    "ioBroker",
    "gauge",
    "meter",
    "home automation",
    "vis-2",
    "vis-2-widgets-gauges"
  ],
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.2.2"
  },
  "files": [
    "admin/",
    "io-package.json",
    "widgets/",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "node tasks",
    "copy-files": "node tasks --copy-files",
    "tsc": "cd src-widgets && npx tsc",
    "check-widgets": "cd src-widgets && node checkWidgets.mjs",
    "preview": "cd src-widgets && npm run preview",
    "screenshots": "cd src-widgets && node preview/screenshots.mjs",
    "lint": "eslint -c eslint.config.mjs",
    "test": "mocha --exit",
    "test:integration": "mocha --exit",
    "test:package": "mocha test/testPackageFiles --exit",
    "npm": "npm i && cd src-widgets && npm i",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-widgets && npx -y npm-check-updates --upgrade",
    "release": "release-script",
    "release-patch": "release-script patch --yes --no-update-lockfile",
    "release-minor": "release-script minor --yes --no-update-lockfile",
    "release-major": "release-script major --yes --no-update-lockfile"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.vis-2-widgets-gauges/issues"
  },
  "readmeFilename": "README.md"
}
